# Anthropic API key — used only by the serverless function in api/generate.js.
# It never reaches the browser. Set it in Vercel → Settings → Environment Variables.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model without a code change. Defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6
